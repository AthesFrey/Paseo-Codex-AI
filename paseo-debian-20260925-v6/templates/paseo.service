[Unit]
Description=Paseo Relay daemon (paseo-debian-20260925-v6)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=paseo
Group=paseo
WorkingDirectory=/srv/proj
EnvironmentFile=/etc/paseo/runtime.env
EnvironmentFile=/etc/paseo/hahaapi.env
ExecStart=/srv/paseo/runtime/node/bin/node /srv/paseo/runtime/apps/node_modules/@getpaseo/cli/bin/paseo daemon run --home /srv/paseo/.paseo
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/paseo /srv/proj
ReadOnlyPaths=/srv/paseo/runtime
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
